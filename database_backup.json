{"updatedAt":1791043685511,"userId":"garbarrocs_at_gmail_com","displayName":"genu","email":"garbarrocs@gmail.com","passwordHash":"d9b40b30af432529b4028948dfcb5057a7922bcc1208a329bbbdb3133df6730e","totalQuestions":5,"totalSessions":0,"totalAttempts":22,"questions":[{"id":4,"userId":"","paperType":"HISTORY","unitName":"Unit 4: Medieval Sources & Sultanate","year":"2011","testName":"UGC NET Dec 2011 Paper-II","questionText":"Match List-I (Foreign Travelers) with List-II (Indian Rulers \/ Patrons):\nList-I:\n(A) Ibn Battuta\n(B) Nicolo Conti\n(C) Abdur Razzaq\n(D) Domingo Paes\nList-II:\n1. Mohd. Bin Tughlaq\n2. Devaraya I\n3. Devaraya II\n4. Krishnadevaraya","optionA":"A-1, B-2, C-3, D-4","optionB":"A-2, B-1, C-4, D-3","optionC":"A-1, B-3, C-2, D-4","optionD":"A-4, B-2, C-3, D-1","correctAnswer":"A","explanation":"Ibn Battuta (from Morocco) visited Delhi during the reign of Muhammad bin Tughlaq and was appointed Qazi. Nicolo Conti visited Vijayanagara under Devaraya I, Abdur Razzaq under Devaraya II, and Domingo Paes under Krishnadevaraya.","questionType":"TEXT","tableDataJson":"","graphImageUrl":"","repeatYears":"","difficulty":"Medium","cognitiveLevel":"Application","createdAtTimestamp":1791043651506,"customOrder":0},{"id":6,"userId":"","paperType":"HISTORY","unitName":"Unit 5: Administration & Economy","year":"2012","testName":"UGC NET June 2012 Paper-II","questionText":"Consider the names of the following Mughal Emperors of the Eighteenth century: (i) Alamgir II (ii) Ahmad Shah (iii) Jahandar Shah (iv) Muhammad Shah. Which among the following sequences represents the correct chronological order?","optionA":"(iii), (iv), (ii), (i)","optionB":"(iv), (iii), (ii), (i)","optionC":"(iii), (ii), (iv), (i)","optionD":"(ii), (iii), (iv), (i)","correctAnswer":"A","explanation":"Chronology of 18th-century later Mughal emperors: (iii) Jahandar Shah (1712-1713) -> (iv) Muhammad Shah 'Rangeela' (1719-1748) -> (ii) Ahmad Shah Bahadur (1748-1754) -> (i) Alamgir II (1754-1759).","questionType":"TEXT","tableDataJson":"","graphImageUrl":"","repeatYears":"","difficulty":"Hard","cognitiveLevel":"Analysis","createdAtTimestamp":1791043651506,"customOrder":0},{"id":7,"userId":"","paperType":"HISTORY","unitName":"Unit 5: Administration & Economy","year":"2013","testName":"UGC NET June 2013 Paper-II","questionText":"Consider the names of the following Mughal emperors of the Eighteenth century: (i) Alamgir II (ii) Ahmad Shah (iii) Jahandar Shah (iv) Muhammad shah. Which among the following sequences represents the correct chronological order of these Mughal emperors?","optionA":"(iii), (iv), (ii), (i)","optionB":"(iv), (iii), (ii), (i)","optionC":"(iii), (ii), (iv), (i)","optionD":"(ii), (iii), (iv), (i)","correctAnswer":"A","explanation":"Exact repetition of the June 2012 question. Chronology: Jahandar Shah (1712-1713), Muhammad Shah (1719-1748), Ahmad Shah (1748-1754), Alamgir II (1754-1759).","questionType":"TEXT","tableDataJson":"","graphImageUrl":"","repeatYears":"","difficulty":"Hard","cognitiveLevel":"Analysis","createdAtTimestamp":1791043651506,"customOrder":0},{"id":8,"userId":"","paperType":"HISTORY","unitName":"Unit 7: Modern Indian History","year":"2012","testName":"UGC NET June 2012 Paper-II","questionText":"Match List-I (Wars \/ Treaties) with List-II (Associated Events):\nList-I:\n(A) First Anglo-Maratha War\n(B) Second Anglo-Maratha War\n(C) Third Anglo-Maratha War\n(D) Treaty of Salbai\nList-II:\n1. Treaty of Bassein\n2. Warren Hastings\n3. Lord Hastings & Abolition of Peshwa\n4. Treaty of Purandhar","optionA":"A-4, B-1, C-3, D-2","optionB":"A-1, B-4, C-2, D-3","optionC":"A-2, B-3, C-1, D-4","optionD":"A-3, B-1, C-4, D-2","correctAnswer":"A","explanation":"The Treaty of Bassein (1802) signed by Peshwa Baji Rao II with the British led directly to the Second Anglo-Maratha War (1803-1805), as Scindia and Bhonsle refused to accept British subsidiary alliance.","questionType":"TEXT","tableDataJson":"","graphImageUrl":"","repeatYears":"","difficulty":"Medium","cognitiveLevel":"Application","createdAtTimestamp":1791043651506,"customOrder":0},{"id":11,"userId":"","paperType":"HISTORY","unitName":"Unit 5: Administration & Economy","year":"2013","testName":"UGC NET June 2013 Paper-II","questionText":"Place the following events in chronological order: (i) Introduction of the dagh system (ii) Battle of Haldighati (iii) Construction of Ibadat Khana (iv) Promulgation of Mahzar. Which code is correct?","optionA":"(i), (iii), (ii), (iv)","optionB":"(iii), (i), (ii), (iv)","optionC":"(i), (ii), (iii), (iv)","optionD":"(ii), (i), (iv), (iii)","correctAnswer":"A","explanation":"Introduction of Dagh system (1573-74), Construction of Ibadat Khana (1575), Battle of Haldighati (June 1576), Promulgation of Mahzar (1579).","questionType":"TEXT","tableDataJson":"","graphImageUrl":"","repeatYears":"","difficulty":"Hard","cognitiveLevel":"Analysis","createdAtTimestamp":1791043651508,"customOrder":0}],"sessions":[],"attempts":[{"userId":"garbarrocs_at_gmail_com","sessionId":"","questionId":3512,"selectedAnswer":"A","isCorrect":true,"timeSpentSeconds":15,"timestamp":1790999854487},{"userId":"garbarrocs_at_gmail_com","sessionId":"","questionId":3513,"selectedAnswer":"A","isCorrect":false,"timeSpentSeconds":15,"timestamp":1790999911102},{"userId":"garbarrocs_at_gmail_com","sessionId":"","questionId":3514,"selectedAnswer":"B","isCorrect":false,"timeSpentSeconds":15,"timestamp":1790999915770},{"userId":"garbarrocs_at_gmail_com","sessionId":"","questionId":4812,"selectedAnswer":"C","isCorrect":false,"timeSpentSeconds":15,"timestamp":1791036754457},{"userId":"garbarrocs_at_gmail_com","sessionId":"","questionId":4813,"selectedAnswer":"B","isCorrect":true,"timeSpentSeconds":15,"timestamp":1791036771511},{"userId":"garbarrocs_at_gmail_com","sessionId":"","questionId":4912,"selectedAnswer":"D","isCorrect":false,"timeSpentSeconds":15,"timestamp":1791038116608},{"userId":"garbarrocs_at_gmail_com","sessionId":"","questionId":4912,"selecte